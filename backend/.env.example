# Port server Express
PORT=4000

# Connection string PostgreSQL (pilih salah satu opsi: Cloud Neon/Supabase atau PostgreSQL Lokal)
# Contoh lokal: postgresql://postgres:postgres@localhost:5432/hackathon_db?schema=public
# Contoh cloud: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=""

# Allowed Origin untuk CORS (Frontend Vite development)
CORS_ORIGIN="http://localhost:5173"

# JWT signing secret (min 16 karakter). Nilai asli jangan pernah di-commit.
JWT_SECRET=""
