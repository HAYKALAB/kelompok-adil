# Port server Express Backend 2
PORT=5000

# Mode Otentikasi: 'jwt' (default jika kosong/tidak dikenali, wajib Bearer token Backend 1)
# atau 'stub' (HANYA untuk pengembangan & testing lokal; dilarang di production)
AUTH_MODE=stub

# JWT Secret signing (Wajib jika AUTH_MODE=jwt, min 16 karakter, sama persis dengan Backend 1)
JWT_SECRET=

# Mode Repository Data: 'stub' (in-memory offline) atau 'db' (PostgreSQL / Neon)
REPO_MODE=stub

# Connection string PostgreSQL Backend 1 (Neon, role khusus backend2 jika mode db aktif)
BACKEND2_DATABASE_URL=

# Kunci API Google Gemini (dapat dikosongkan jika AI_MOCK=true)
GEMINI_API_KEY=

# Model Gemini yang digunakan
AI_MODEL=gemini-2.5-flash

# Mode Simulasi / Mock (setel true agar demo lancar tanpa kuota/internet)
AI_MOCK=true

# Batas waktu panggilan AI (milidetik)
AI_TIMEOUT_MS=10000

# Ambang batas jam peringatan tugas sebelum tenggat waktu
GHOSTING_WARN_HOURS=48

# Jeda minimal pengiriman pengingat ramah per tugas (jam) guna mencegah pesan duplikat
GHOSTING_NUDGE_INTERVAL_HOURS=24
