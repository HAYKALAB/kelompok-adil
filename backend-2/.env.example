# Port server Express Backend 2
PORT=5000

# Kunci API Google Gemini (dapat dikosongkan jika AI_MOCK=true)
GEMINI_API_KEY=

# Model Gemini yang digunakan
AI_MODEL=gemini-2.5-flash

# Mode Simulasi / Mock (setel true agar demo lancar tanpa kuota/internet)
AI_MOCK=true

# Connection string PostgreSQL Backend 1 (Neon, role khusus backend2)
BACKEND2_DATABASE_URL=
